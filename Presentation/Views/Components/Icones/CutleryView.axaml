<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="90" d:DesignHeight="60"
             x:Class="MiComanderaApp.Presentation.Views.Components.Icones.CutleryView">
  <Grid Width="90" Height="60" ColumnDefinitions="*,*">
        <!-- Tenedor (izquierda) -->
        <PathIcon Grid.Column="0" Width="25" Height="40"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="Silver"
                  Data="M7 2v7h2V2h2v7h2V2h2v7c0 2.21-1.79 4-4 4s-4-1.79-4-4V2h2zm4 15c-1.66 0-3 1.34-3 3h6c0-1.66-1.34-3-3-3z"/>

        <!-- Cuchillo (derecha) -->
        <PathIcon Grid.Column="1" Width="25" Height="40"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="Silver"
                  Data="M9 2v7c0 1.1.9 2 2 2s2-.9 2-2V2h2v7c0 2.21-1.79 4-4 4s-4-1.79-4-4V2h2zm3 13c-1.1 0-2 .9-2 2v2c0 1.1.9 2 2 2s2-.9 2-2v-2c0-1.1-.9-2-2-2z"/>
    </Grid>
</UserControl>

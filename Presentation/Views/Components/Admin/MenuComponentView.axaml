<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:componentes="using:MiComanderaApp.Presentation.Views.Animations"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MiComanderaApp.ViewModels.Components.Admin"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:models="using:MiComanderaApp.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MiComanderaApp.Views.Components.Admin.MenuComponentView"
             x:DataType="vm:MenuComponentViewModel"
             x:Name="Root">

  <UserControl.Resources>
    <DataTemplate x:Key="ShowProducts" DataType="{x:Type models:ProductoModel}">
        <Border Background="{DynamicResource FondoTarjeta}" Width="300" MaxHeight="260" CornerRadius="12" ClipToBounds="True" Margin="5" >
            <Grid RowDefinitions="110,*">

                <Grid Grid.Row="0">
                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>

                    <Border Background="#15000000"/>

                    <Border Background="{DynamicResource Estadistica}"
                            CornerRadius="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="8,4">
                        <TextBlock Text="{Binding CategoryName}" Foreground="{DynamicResource TextoColor}" FontSize="13" FontWeight="Bold"/>
                    </Border>

                    <Border Background="{DynamicResource NumBotton}"
                            CornerRadius="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="6,4">
                        <TextBlock Text="{Binding IsAvailable}" Foreground="{DynamicResource TextoColor}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Padding="15,12" Grid.RowSpan="2">
                    <Grid RowDefinitions="Auto,Auto,Auto">

                        <TextBlock Grid.Row="0"
                                   Text="{Binding Name}"
                                   Foreground="{DynamicResource TextoColor}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   />

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,1,0,10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="S/" Foreground="{DynamicResource Estadistica}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}'}" Foreground="{DynamicResource Estadistica}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TaxPercentage, StringFormat='{}IVA {0}%'}" Foreground="#4F5E67" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <i:Icon Value="fa-solid fa-print" Foreground="{DynamicResource TextoColor}" FontSize="11"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#4F5E67" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Background="{DynamicResource BorderEditar}"
                                    Height="32"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="6"
                                    Command="{Binding #Root.DataContext.EditarProductoCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <i:Icon Value="fa-solid fa-pen" Foreground="{DynamicResource BotonText}" FontSize="12"/>
                                    <TextBlock Text="Editar" Foreground="{DynamicResource BotonText}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Background="{DynamicResource BotonDelete}"
                                    Width="35" Height="32"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="6">
                                <i:Icon Value="fa-solid fa-trash" Foreground="#c91815" FontSize="12"/>
                            </Button>
                        </Grid>
                </Grid>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <componentes:LoadingView
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      IsVisible="{Binding IsLoading}"
      />

    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}" Margin="24">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
        <TextBlock Grid.Column="0"
                   Text="Configurador de Menú"
                   Foreground="{DynamicResource TextoColor}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

        <Button Grid.Column="1"
                Padding="16,8"
                CornerRadius="6"
                Command="{Binding NuevoProductoCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-plus" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Text="Nuevo ítem" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,25">
        <StackPanel.Styles>
          <Style Selector="Button">
            <Setter Property="Background" Value="#1A202C"/>
            <Setter Property="Foreground" Value="#5F6E77"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
          </Style>
          <Style Selector="Button.Active">
            <Setter Property="Background" Value="#32221A"/>
            <Setter Property="Foreground" Value="#E06A28"/>
            <Setter Property="BorderBrush" Value="#E06A28"/>
            <Setter Property="BorderThickness" Value="1"/>
          </Style>
        </StackPanel.Styles>

        <Button Content="Todas" Classes="Active" Command="{Binding #Root.DataContext.LoadProductsCommand}"/>
        <ItemsControl ItemsSource="{Binding Categorias}"
                      HorizontalAlignment="Right">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Name}"
                      Classes="Botton"
                      Command="{Binding #Root.DataContext.ChangeCatalogoCommand}"
                      CommandParameter="{Binding Id}"
                      />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="+"/>
      </StackPanel>

      <Grid Grid.Row="2">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

          <ItemsControl ItemsSource="{Binding Products}"
                        ItemTemplate="{StaticResource ShowProducts}">

            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

          </ItemsControl>

        </ScrollViewer>

      </Grid>
    </Grid>

  </Grid>
</UserControl>

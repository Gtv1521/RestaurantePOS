<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:admin="using:MiComanderaApp.ViewModels.Components.Admin"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:models="using:MiComanderaApp.Core.Domain.Models"
             xmlns:recetas="using:RestaurantePOS.Core.Domain.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MiComanderaApp.Views.Components.Admin.InventarioComponentView"
             x:DataType="admin:InventarioComponentViewModel"
             x:Name="Root">
    
    <UserControl.Resources>
        <!-- Template para Ingredientes -->
        <DataTemplate x:Key="IngredientCardTemplate" DataType="{x:Type models:IngredienteModel}">
            <Border Background="{DynamicResource FondoTarjeta}" Width="300" MinHeight="180" CornerRadius="12" ClipToBounds="True" Margin="5">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Padding="15,12">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextoColor}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    
                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="5" Margin="15,0">
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0" Text="Cant. Disponible:" Foreground="{DynamicResource TextoColor}" Opacity="0.7"/>
                            <TextBlock Grid.Column="1" Text="{Binding AvailableQuantity}" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0" Text="Cant. Mínima:" Foreground="{DynamicResource TextoColor}" Opacity="0.7"/>
                            <TextBlock Grid.Column="1" Text="{Binding MinimumQuantity}" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                         <Grid ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0" Text="Unidad:" Foreground="{DynamicResource TextoColor}" Opacity="0.7"/>
                            <TextBlock Grid.Column="1" Text="{Binding UnitOfMeasure}" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0" Text="Costo Unit.:" Foreground="{DynamicResource TextoColor}" Opacity="0.7"/>
                            <TextBlock Grid.Column="1" Text="{Binding UnitCost, StringFormat='S/ {0:N2}'}" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="15,12">
                        <Button Grid.Column="0" Background="#222B36" Height="32"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding #Root.DataContext.EditIngredienteCommand}" CommandParameter="{Binding}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="fa-solid fa-pen" Foreground="{DynamicResource BotonTextWhite}"/>
                                <TextBlock Text="Editar" Foreground="{DynamicResource BotonTextWhite}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Background="{DynamicResource BotonDelete}" Width="35" Height="32"
                                Command="{Binding #Root.DataContext.DeleteIngredienteCommand}" CommandParameter="{Binding}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="6">
                            <i:Icon Value="fa-solid fa-trash" Foreground="#c91815" FontSize="12"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template para Recetas -->
        <DataTemplate x:Key="RecipeCardTemplate" DataType="{x:Type recetas:RecetaModel}">
            <Border Background="{DynamicResource FondoTarjeta}" Width="300" CornerRadius="12" Margin="5" MinHeight="250">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <Border Grid.Row="0" Height="120" Background="{DynamicResource FondoInput}" CornerRadius="12,12,0,0">
                        <i:Icon Value="fa-solid fa-utensils" Foreground="{DynamicResource TextoColor}" Opacity="0.3" FontSize="40"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <Border Grid.Row="1" Padding="15,12">
                        <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextoColor}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Grid.Row="2" Margin="15,0">
                        <!-- Vista para cuando SI hay receta -->
                        <StackPanel Orientation="Vertical" Spacing="5" IsVisible="{Binding HasRecipe}">
                            <TextBlock Text="Ingredientes:" Foreground="{DynamicResource TextoColor}" Opacity="0.7" FontWeight="Bold"/>
                            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type recetas:IngredientModel}">
                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,2,10,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextoColor}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0:0.##}'}" Foreground="{DynamicResource TextoColor}" FontSize="12" FontWeight="SemiBold" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding UnitOfMeasure}" Foreground="{DynamicResource TextoColor}" FontSize="12" Opacity="0.7"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Vista para cuando NO hay receta -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasRecipe}" Spacing="10">
                            <i:Icon Value="fa-solid fa-file-circle-plus" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource TextoColor}" Opacity="0.4"/>
                            <TextBlock Text="Este producto no tiene receta" Foreground="{DynamicResource TextoColor}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="15,12">
                        <!-- Botones para receta existente -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasRecipe}">
                            <Button Grid.Column="0" Background="#222B36" Height="32"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Command="{Binding #Root.DataContext.EditRecipeCommand}" CommandParameter="{Binding}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <i:Icon Value="fa-solid fa-pen" Foreground="{DynamicResource BotonTextWhite}"/>
                                    <TextBlock Text="Editar Receta" Foreground="{DynamicResource BotonTextWhite}" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Background="{DynamicResource BotonDelete}" Width="35" Height="32"
                                    Command="{Binding #Root.DataContext.DeleteRecipeCommand}" CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="6">
                                <i:Icon Value="fa-solid fa-trash" Foreground="#c91815" FontSize="12"/>
                            </Button>
                        </Grid>

                        <!-- Botón para crear receta -->
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding !HasRecipe}"
                                Command="{Binding #Root.DataContext.CreateRecipeFromProductCommand}" CommandParameter="{Binding}"
                                Background="#E06A28" Height="32" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-solid fa-plus" Foreground="White" FontSize="12"/>
                                <TextBlock Text="Crear Receta" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">

        <!-- Header dinámico o estático -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" Text="Gestión de Inventario y Recetas" Foreground="{DynamicResource TextoColor}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>

            <!-- Botón dinámico según la pestaña seleccionada -->
            <Button Grid.Column="1" Background="#E06A28" Padding="16,8" CornerRadius="6" 
                    Command="{Binding AddIngredienteCommand}" IsVisible="{Binding IsIngredientesSelected}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <i:Icon Value="fa-solid fa-plus" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Nuevo Ingrediente" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Background="#E06A28" Padding="16,8" CornerRadius="6" 
                    Command="{Binding NewRecipeCommand}" IsVisible="{Binding !IsIngredientesSelected}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <i:Icon Value="fa-solid fa-plus" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Nueva Receta" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Search Bar -->
        <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource FondoInput}" Padding="12,0" Margin="0,0,0,20">
            <Grid ColumnDefinitions="Auto,*">
                <i:Icon Grid.Column="0" Value="fa-solid fa-search" Foreground="{DynamicResource TextoColor}" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.5"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Buscar ingrediente o receta..."
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Botones de Pestañas -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,25">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="#1A202C"/>
                    <Setter Property="Foreground" Value="#5F6E77"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
                <Style Selector="Button.Active">
                    <Setter Property="Background" Value="#32221A"/>
                    <Setter Property="Foreground" Value="#E06A28"/>
                    <Setter Property="BorderBrush" Value="#E06A28"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </StackPanel.Styles>

            <Button Content="Ingredientes" 
                    Command="{Binding LoadIngredientesCommand}"
                    Classes.Active="{Binding IsIngredientesSelected}"/>
            
            <Button Content="Recetas" 
                    Command="{Binding LoadRecetasCommand}"
                    Classes.Active="{Binding !IsIngredientesSelected}"/>
        </StackPanel>

        <!-- Contenedor scrolleable que cambia los ItemsSource y templates según la selección -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Panel>
                <!-- Lista de Ingredientes -->
                <ItemsControl ItemsSource="{Binding Ingredientes}" 
                              ItemTemplate="{StaticResource IngredientCardTemplate}"
                              IsVisible="{Binding IsIngredientesSelected}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Lista de Recetas -->
                <ItemsControl ItemsSource="{Binding Recetas}" 
                              ItemTemplate="{StaticResource RecipeCardTemplate}"
                              IsVisible="{Binding !IsIngredientesSelected}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MiComanderaApp.Presentation.ViewModels.Components.Inventario"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:models="using:MiComanderaApp.Core.Domain.Models"
             xmlns:converters="using:MiComanderaApp.Presentation.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MiComanderaApp.Presentation.Views.Components.Inventario.InventarioComponent"
             x:DataType="vm:InventarioComponentViewModel">
    <UserControl.Resources>
        <converters:QuantityToColorConverter x:Key="QuantityToColorConverter"/>
        <converters:QuantityToStatusBackgroundBrushConverter x:Key="QuantityToStatusBackgroundBrushConverter"/>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">

        <!-- Botones de Acción -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" Text="Gestión de Inventario" Foreground="{DynamicResource TextoColor}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="Outline" Padding="16,8" CornerRadius="6" Margin="0,0,10,0" Command="{Binding PrintInventoryCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <i:Icon Value="fa-solid fa-print" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Imprimir" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Background="{DynamicResource Estadistica}" Padding="16,8" CornerRadius="6" Margin="0,0,10,0" Command="{Binding NewIngredientCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource BotonText}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Nuevo Ingrediente" Foreground="{DynamicResource BotonText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Background="{DynamicResource Estadistica}" Padding="16,8" CornerRadius="6" Command="{Binding NewRecipeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <i:Icon Value="fa-solid fa-plus" Foreground="{DynamicResource BotonText}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Nueva Receta" Foreground="{DynamicResource BotonText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Pestañas de Navegación -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,25">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="{DynamicResource FondoTarjeta}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Resalto}"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
                <Style Selector="Button.Active">
                    <Setter Property="Background" Value="{DynamicResource PanelName}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Estadistica}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Estadistica}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </StackPanel.Styles>
            <Button Content="Ingredientes" Classes="Active" Command="{Binding LoadIngredientsCommand}"/>
            <Button Content="Recetas" Command="{Binding LoadRecipesCommand}"/>
        </StackPanel>
        <!-- Cabecera de la Tabla -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Bordes}" BorderThickness="0,1,0,1" Padding="12,8">
            <Grid ColumnDefinitions="50, 2*, *, *, *, *, *, 240">
                <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}"/>
                <TextBlock Grid.Column="1" Text="Nombre" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}"/>
                <TextBlock Grid.Column="2" Text="Disponible" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Mínimo" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="Unidad" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="Costo Unit." FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="7" Text="Acciones" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Filas del Inventario -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Ingredients}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:IngredienteModel">
                        <Border BorderBrush="{DynamicResource Bordes}" BorderThickness="0,0,0,1" Padding="12,14" 
                                Background="{Binding AvailableQuantity, Converter={StaticResource QuantityToStatusBackgroundBrushConverter}, ConverterParameter={Binding MinimumQuantity}}">
                            <Grid ColumnDefinitions="50, 2*, *, *, *, *, *, 240" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource TextoColor}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}"/>
                                <TextBlock Grid.Column="2" Text="{Binding AvailableQuantity}" HorizontalAlignment="Right" Foreground="{DynamicResource TextoColor}"/>
                                <TextBlock Grid.Column="3" Text="{Binding MinimumQuantity}" HorizontalAlignment="Right" Foreground="{DynamicResource TextoColor}"/>
                                <TextBlock Grid.Column="4" Text="{Binding UnitOfMeasure}" HorizontalAlignment="Center" Foreground="{DynamicResource TextoColor}"/>
                                <TextBlock Grid.Column="5" Text="{Binding UnitCost, StringFormat={}{0:C}}" HorizontalAlignment="Right" Foreground="{DynamicResource TextoColor}"/>
                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                    <Button Foreground="{DynamicResource BotonText}" Background="{DynamicResource BotonFondo}" BorderBrush="{DynamicResource Bordes}" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <i:Icon Value="fa-solid fa-gear" Foreground="{DynamicResource BotonText}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ajustar" Foreground="{DynamicResource BotonText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Foreground="{DynamicResource BotonText}" Background="{DynamicResource BotonFondo}" BorderBrush="{DynamicResource Bordes}" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <i:Icon Value="fa-solid fa-pen-to-square" Foreground="{DynamicResource BotonText}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Editar" Foreground="{DynamicResource BotonText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Foreground="{DynamicResource BotonText}" Background="{DynamicResource BotonFondo}" BorderBrush="{DynamicResource Bordes}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <i:Icon Value="fa-solid fa-trash" Foreground="{DynamicResource BotonText}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Eliminar" Foreground="{DynamicResource BotonText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
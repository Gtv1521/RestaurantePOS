<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MiComanderaApp.ViewModels.Orders"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500"
             x:Class="MiComanderaApp.Views.Orders.ElegirAcompanamientosView"
             x:DataType="vm:ElegirAcompanamientosViewModel"
             x:Name="Root">

    <Border Background="{DynamicResource FondoPrincipal}"
            CornerRadius="15"
            Padding="20"
            Width="500">
        <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="10">

            <TextBlock Grid.Row="0" Text="Elige acompañamientos" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextoBrush}"/>
            <TextBlock Grid.Row="1" Text="{Binding NombreProducto}" FontSize="14"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextoColor}" Opacity="0.7"/>

            <ListBox Grid.Row="2" ItemsSource="{Binding Opciones}" Background="Transparent"
                     MaxHeight="300" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AcompanamientoElegible}">
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Command="{Binding #Root.DataContext.AlternarCommand}"
                                CommandParameter="{Binding}">
                            <Border Padding="12" Margin="0,0,0,6" Background="{DynamicResource FondoModal}" CornerRadius="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Acompanamiento.Name}" Foreground="{DynamicResource TextoColor}"
                                                   FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Acompanamiento.Description}" Foreground="{DynamicResource TextoColor}"
                                                   FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                            Background="#4CAF50" VerticalAlignment="Center"
                                            IsVisible="{Binding Seleccionado}">
                                        <TextBlock Text="✓" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="Cancelar" Width="140" Height="40" Classes="btn-rojo" Command="{Binding CancelarCommand}"/>
                <Button Content="Agregar" Width="140" Height="40" Classes="btn-verde" Command="{Binding ConfirmarCommand}"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>

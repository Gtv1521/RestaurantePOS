<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mesas="using:MiComanderaApp.ViewModels.Mesas"
             xmlns:modals="using:MiComanderaApp.ViewModels.Dialogs.Modals"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MiComanderaApp.Views.Mesas.DataTableView"
             x:DataType="mesas:DataTableViewModel"
             Background="{DynamicResource FondoPrincipal}"
             x:Name="Root"
             >

  <UserControl.Styles>
    <Style Selector="Button.pago-metodo">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource FondoModal}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextoColor}"/>
      <Setter Property="BorderBrush" Value="#E06A28"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Height" Value="60"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.pago-metodo.activo">
      <Setter Property="Background" Value="#E06A28"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.pago-metodo:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C2410C"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="3*, 7*" Margin="15">

    <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="0,0,10,0">

      <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,5">

        <Grid ColumnDefinitions="*,Auto">

          <!-- Izquierda -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">

            <TextBlock Text="MESA"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextoColor}"/>

            <TextBlock FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Estadistica}">
              <Run Text="  " />
              <Run Text="{Binding NumeroMesa}" />
              <Run Text="/" />
              <Run Text="{Binding Instancia}" />
            </TextBlock>

          </StackPanel>

          <!-- Derecha -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="15"
                      HorizontalAlignment="Right">

            <TextBlock Text="{Binding NombreMesaCustom}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextoColor}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding NombreMesaCustom, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Border CornerRadius="12"
                    Padding="8,3"
                    VerticalAlignment="Center">

              <TextBlock Text="{Binding CantidadProd}"
                         Foreground="{DynamicResource TextoBrush}"
                         FontWeight="Bold"/>

            </Border>

          </StackPanel>

        </Grid>

        <!-- Datos secundarios (Mesero y Hora) -->
        <Grid ColumnDefinitions="*, *, *">
          <TextBlock Grid.Column="0" Text="{Binding NombreMesero, StringFormat='Mesero: {0}'}" FontSize="13" Foreground="#98A2B3" HorizontalAlignment="Left"/>
          <TextBlock Grid.Column="1" Text="{Binding CantidadPax, StringFormat='Pax: {0}'}" FontSize="13" Foreground="#98A2B3" HorizontalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding HoraApertura, StringFormat='Hora: {0:HH:mm}'}" FontSize="13" Foreground="#98A2B3" HorizontalAlignment="Right"/>
        </Grid>

        <Separator Background="#2D3139" Height="1" Margin="0,5,0,0"/>
      </StackPanel>

      <ListBox Grid.Row="1"
               x:Name="ListaPedidos"
               ItemsSource="{Binding ProductosPedidos}"
               SelectionMode="{Binding ModoSeleccion}"
               SelectedItems="{Binding ProductosSeleccionados, Mode=TwoWay}"
               Background="{DynamicResource FondoTarjeta}"
               CornerRadius="12"
               Padding="5">

        <ListBox.ItemTemplate>
          <DataTemplate>

            <StackPanel Margin="1,1"
                        Spacing="1">

              <!-- Información principal del producto -->
              <Grid ColumnDefinitions="*, *, *">

                <TextBlock Grid.Column="0"
                           Text="{Binding Nombre}"
                           Foreground="{DynamicResource TextoColor}"
                           FontWeight="Bold"
                           FontSize="17"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Cantidad, StringFormat='x{0}'}"
                           Margin="15,0"
                           Foreground="{DynamicResource Estadistica}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding TotalProducto, StringFormat='${0:N0}'}"
                           Foreground="{DynamicResource Resalto}"
                           VerticalAlignment="Center"/>

              </Grid>


              <!-- Término y acompañamientos -->
              <TextBlock Margin="15,0,0,0"
                         FontSize="13"
                         Foreground="{DynamicResource Estadistica}"
                         IsVisible="{Binding TieneDetalle}">
                <Run Text="• "/>
                <Run Text="{Binding TerminoNombre}"/>
              </TextBlock>

              <ItemsControl ItemsSource="{Binding AcompanamientoNombres}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="15,0,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource Estadistica}">
                      <Run Text="+ "/>
                      <Run Text="{Binding}"/>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Observaciones -->
              <ItemsControl ItemsSource="{Binding Observaciones}">

                <ItemsControl.ItemTemplate>
                  <DataTemplate>

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          Margin="15,0,0,0">

                      <!-- Nombre observación -->
                      <TextBlock Grid.Column="0"
                                 FontSize="14"
                                 Foreground="{DynamicResource Estadistica}">
                        <Run Text="+ "/>
                        <Run Text="{Binding Item}"/>
                      </TextBlock>

                      <TextBlock Grid.Column="1"
                                 IsVisible="{Binding TieneCantidad}"
                                 Text="{Binding Cantidad, StringFormat='x{0}'}"
                                 Margin="15,0"
                                 Foreground="{DynamicResource Estadistica}"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"/>

                      <!-- Valor observación -->
                      <TextBlock Grid.Column="2"
                                 IsVisible="{Binding TienePrecio}"
                                 Text="{Binding Valor, StringFormat='${0:N0}'}"
                                 FontSize="12"
                                 Foreground="{DynamicResource Resalto}"
                                 Margin="15,0,0,0"/>

                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="2" Background="{DynamicResource FondoTarjeta}"  CornerRadius="18" Padding="15" Margin="0,15,0,0">
        <!-- Cambiamos a un Grid de 3 filas para el desglose y el Total -->
        <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto">

          <!-- 1. Fila de Impuesto al Consumo -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="IPOCONSUMO" FontSize="13" Foreground="{DynamicResource Resalto}" FontWeight="Medium" Margin="10,2,0,2"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalIpoconsumo, StringFormat='${0:N0}'}" FontSize="14" Foreground="{DynamicResource Resalto}" HorizontalAlignment="Right" Margin="0,2,10,2"/>

          <!-- 2. Fila de Valor del Servicio (Propina voluntaria calculada sobre la base) -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="SERVICIO (PROPINA)" FontSize="13" Foreground="{DynamicResource Resalto}" FontWeight="Medium" Margin="10,2,0,2"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalServicio, StringFormat='${0:N0}'}" FontSize="14" Foreground="{DynamicResource Resalto}" HorizontalAlignment="Right" Margin="0,2,10,2"/>

          <!-- 2. Fila de Valor del Servicio (Propina voluntaria calculada sobre la base) -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Neto" FontSize="13" Foreground="{DynamicResource Resalto}" FontWeight="Medium" Margin="10,2,0,10"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalNeto, StringFormat='${0:N0}'}" FontSize="14" Foreground="{DynamicResource Resalto}" HorizontalAlignment="Right" Margin="0,2,10,10"/>

          <!-- Línea divisoria sutil antes del gran total -->
          <Separator Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource Resalto}" Height="1" VerticalAlignment="Top" Margin="10,0,10,10"/>

          <!-- 3. Fila del Total General -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="TOTAL A PAGAR" FontSize="15" Foreground="{DynamicResource TextoColor}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,5,0,0"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalCuenta, StringFormat='${0:N0}'}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextoColor}" VerticalAlignment="Center" Margin="0,5,10,0"/>

        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Column="1" RowDefinitions="7*,3*">

      <Grid Grid.Row="0" ColumnDefinitions="*,210" ColumnSpacing="5" IsVisible="{Binding !ModoPago}">

        <!-- Panel Productos -->
        <Border Grid.Column="0"
                Background="{DynamicResource FondoTarjeta}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">

          <Grid RowDefinitions="Auto,*">

            <TextBlock Grid.Row="0"
                       Text="{Binding NamePanel}"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextoBrush}"
                       Margin="5,0,5,10"/>

            <ScrollViewer Grid.Row="1"
                          IsVisible="{Binding !MostrandoObservaciones}">

              <ItemsControl ItemsSource="{Binding ProductosCatalogo}">

                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="5"
                                 Rows="8"
                                 RowSpacing="5"
                                 ColumnSpacing="5"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate>

                    <Button MinHeight="70"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{Binding #Root.DataContext.AgregarProductoCommand}"
                            CommandParameter="{Binding}"
                            Classes="btn-verde">
                      <Grid>
                        <!-- CAPA BASE: nombre + cantidad (ocupa toda la celda) -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    Margin="8,8,24,8"
                                    Spacing="2">
                          <TextBlock Text="{Binding Nombre}"
                                     TextWrapping="Wrap"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextoBrush}"/>
                          <TextBlock Text="{Binding TextoCantidad}"
                                     FontSize="12"
                                     Opacity="0.85"
                                     Foreground="{DynamicResource TextoBrush}"/>
                        </StackPanel>

                        <!-- CAPA SUPERPUESTA: icono X encima del bloque anterior -->
                        <i:Icon Value="fa-solid fa-xmark"
                                FontSize="16"
                                Foreground="Red"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="4"
                                IsVisible="{Binding MostrarIconoX, FallbackValue=False}"/>
                      </Grid>
                    </Button>

                  </DataTemplate>
                </ItemsControl.ItemTemplate>

              </ItemsControl>

            </ScrollViewer>


            <!-- OBSERVACIONES -->
            <ScrollViewer Grid.Row="1"
                          IsVisible="{Binding MostrandoObservaciones}">

              <ItemsControl ItemsSource="{Binding Observations}">

                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="5"
                                 Rows="8"
                                 RowSpacing="5"
                                 ColumnSpacing="5"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate>

                    <Button MinHeight="70"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{Binding Item}"
                            Classes="btn-verde"
                            Command="{Binding #Root.DataContext.AgregarObservacionCommand}"
                            CommandParameter="{Binding}"
                            />

                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Panel Categorías -->
        <Border Grid.Column="1"
                Background="{DynamicResource FondoTarjeta}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">

          <Grid RowDefinitions="Auto,*">

            <TextBlock Grid.Row="0"
                       Text="CATEGORÍAS"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextoBrush}"
                       Margin="5,0,5,10"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

              <ItemsControl ItemsSource="{Binding Categorias}">

                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="180"
                            Height="70"
                            Margin="5"
                            Classes="btn-azul"
                            Content="{Binding Nombre}"
                            Command="{Binding #Root.DataContext.ChangeCategoriaCommand}"
                            CommandParameter="{Binding Id}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource FondoTarjeta}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,8,0,0" IsVisible="{Binding !ModoPago}">
        <Grid ColumnDefinitions="*,300" RowDefinitions="*" >


          <Grid Grid.Column="0"
                RowDefinitions="Auto,*,*,*"
                ColumnDefinitions="*,*,*,*"
                RowSpacing="5"
                ColumnSpacing="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                >

            <!-- titulo  -->
            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="4"
                       Text="OPCIONES"
                       FontSize="13"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextoBrush}"
                       />


            <!-- Primera fila-->
            <Button Grid.Row="1"
                    Grid.Column="0"
                    Content="{Binding TextoBotonAnular}"
                    Command="{Binding AlternarModoSeleccionCommand}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Classes="btn-rojo"
                    />

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="Observaciones"
                    Command="{Binding ChargerObservationsCommand}"
                    Classes="btn-verde"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    />

            <Button Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Content="Enviar"
                    Command="{Binding EnviarOrdenCommand}"
                    Classes="btn-naranja"/>

            <Button Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="3"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Content="Cancelar"
                    Classes="btn-rojo"
                    Command="{Binding CancelarCommand}"
                    />


            <!-- segunda fila-->
            <Button Grid.Row="2"
                    Grid.Column="0"
                    Content="Clientes"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Classes="btn-verde"
                    />

            <Button Grid.Row="2"
                    Grid.Column="1"
                    Content="Historial"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Classes="btn-verde"
                    />


            <!-- tercera fila -->
            <Button Grid.Row="3"
                    Grid.Column="0"
                    IsVisible="{Binding EsCaja}"
                    Content="👤 Cliente"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Classes="btn-azul"
                    Command="{Binding EditarDatosClienteCommand}"
                    />

            <Button Grid.Row="3"
                    Grid.Column="1"
                    IsVisible="{Binding EsCaja}"
                    Content="Prefactura"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Classes="btn-gris"
                    Command="{Binding PrefacturaCommand}"
                    />

            <Button Grid.Row="3"
                    Grid.Column="3"
                    Content="Volver"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Classes="btn-azul"
                    Command="{Binding VolverCommand}"
                    />


            <!-- cuarta fila -->
            <Button Grid.Row="3"
                    Grid.Column="2"
                    IsVisible="{Binding EsCaja}"
                    Content="💰 Pagar"
                    FontWeight="Bold"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Classes="btn-verde"
                    Command="{Binding CobrarCommand}"
                    />
          </Grid>

          <!-- panle de numeros -->
          <Grid Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="10,0,0,0"
                RowDefinitions="*,*,*,*"
                ColumnDefinitions="*,*,*">

            <Button Grid.Row="0" Grid.Column="0" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="1" Content="1"  />
            <Button Grid.Row="0" Grid.Column="1" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="2" Content="2"/>
            <Button Grid.Row="0" Grid.Column="2" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="3" Content="3"/>

            <Button Grid.Row="1" Grid.Column="0" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="4" Content="4"/>
            <Button Grid.Row="1" Grid.Column="1" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="5" Content="5"/>
            <Button Grid.Row="1" Grid.Column="2" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="6" Content="6"/>

            <Button Grid.Row="2" Grid.Column="0" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="7" Content="7"/>
            <Button Grid.Row="2" Grid.Column="1" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="8" Content="8"/>
            <Button Grid.Row="2" Grid.Column="2" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="9" Content="9"/>

            <Button Grid.Row="3" Grid.Column="0" Classes="KeypadBtn" Content=""/>
            <Button Grid.Row="3" Grid.Column="1" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="0" Content="0"/>
            <Button Grid.Row="3" Grid.Column="2" Classes="KeypadBtn" Command="{Binding BorrarNumeroCommand}" Content="⌫"/>
          </Grid>

        </Grid>
      </Border>

      <!-- ============================================================ -->
      <!-- VISTA DE COBRO (en línea, sin ventana modal)                  -->
      <!-- ============================================================ -->
      <Border Grid.Row="0"
              Grid.RowSpan="2"
              IsVisible="{Binding ModoPago}"
              Background="{DynamicResource FondoTarjeta}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="15">
        <Grid RowDefinitions="*,330" RowSpacing="12">

          <Grid Grid.Row="0" RowDefinitions="Auto,*" RowSpacing="10">

            <!-- Datos del cliente -->
            <Border Grid.Row="0"
                    Background="{DynamicResource FondoModal}"
                    CornerRadius="10"
                    Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="DATOS DEL CLIENTE"
                           IsVisible="{Binding !AgregandoCliente}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextoBrush}"/>

                <!-- MODO BUSCAR (visible mientras no se agrega un cliente) -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding !AgregandoCliente}">
                  <TextBox Grid.Column="0"
                           Text="{Binding ClienteBusqueda, Mode=TwoWay}"
                           Watermark="Documento o nombre del cliente..."
                           Foreground="{DynamicResource TextoColor}"
                           BorderBrush="{DynamicResource Border}"/>
                  <Button Grid.Column="1"
                          Content="🔍 Cargar"
                          Height="36"
                          Classes="btn-azul"
                          Command="{Binding CargarClienteCommand}"/>
                  <Button Grid.Column="2"
                          Content="➕ Agregar cliente"
                          Height="36"
                          Classes="btn-verde"
                          Command="{Binding AgregarClienteCommand}"/>
                </Grid>

                <!-- MODO AGREGAR (formulario; oculta la búsqueda) -->
                <StackPanel Spacing="8" IsVisible="{Binding AgregandoCliente}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Button Grid.Column="0"
                            Content="← Volver a buscar"
                            Height="30"
                            Padding="10,0"
                            Classes="btn-gris"
                            Command="{Binding VolverBuscarClienteCommand}"/>
                    <TextBlock Grid.Column="1"
                               Text="DATOS DEL CLIENTE"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextoBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                  </Grid>

                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                      <TextBlock Text="Nombre / Razón social" FontSize="12" Foreground="{DynamicResource TextoColor}" Opacity="0.8"/>
                      <TextBox Text="{Binding PagoClienteNombre, Mode=TwoWay}"
                               Watermark="Consumidor final"
                               Foreground="{DynamicResource TextoColor}"
                               BorderBrush="{DynamicResource Border}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                      <TextBlock Text="NIT / Documento" FontSize="12" Foreground="{DynamicResource TextoColor}" Opacity="0.8"/>
                      <TextBox Text="{Binding PagoClienteDocumento, Mode=TwoWay}"
                               Watermark="Ej: 12345678"
                               Foreground="{DynamicResource TextoColor}"
                               BorderBrush="{DynamicResource Border}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                      <TextBlock Text="Dirección" FontSize="12" Foreground="{DynamicResource TextoColor}" Opacity="0.8"/>
                      <TextBox Text="{Binding PagoClienteDireccion, Mode=TwoWay}"
                               Watermark="Ej: Av. Principal 123"
                               Foreground="{DynamicResource TextoColor}"
                               BorderBrush="{DynamicResource Border}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                      <TextBlock Text="Teléfono" FontSize="12" Foreground="{DynamicResource TextoColor}" Opacity="0.8"/>
                      <TextBox Text="{Binding PagoClienteTelefono, Mode=TwoWay}"
                               Watermark="Ej: 999888777"
                               Foreground="{DynamicResource TextoColor}"
                               BorderBrush="{DynamicResource Border}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <!-- Mensaje (compartido en ambos modos) -->
                <TextBlock Text="{Binding ClienteMensaje}"
                           IsVisible="{Binding ClienteMensajeVisible}"
                           FontSize="12"
                           Foreground="#E06A28"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Pagos agregados -->
            <Border Grid.Row="1"
                    Background="{DynamicResource FondoModal}"
                    CornerRadius="10"
                    Padding="10">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <TextBlock Grid.Column="0" Text="PAGOS AGREGADOS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextoBrush}" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Background="{DynamicResource FondoPrincipal}" CornerRadius="8" Padding="12,2">
                    <TextBlock Text="{Binding PagoValorTeclado, StringFormat='${0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#27AE60"/>
                  </Border>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding PagosAgregados}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource FondoPrincipal}" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding MetodoNombre}" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding MontoTexto}" Foreground="#27AE60" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="✕"
                                    Background="Transparent"
                                    Foreground="#E74C3C"
                                    Padding="6,2"
                                    Command="{Binding #Root.DataContext.QuitarPagoCommand}"
                                    CommandParameter="{Binding}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- Totales -->
                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5" Margin="0,8,0,0">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="TOTAL" FontSize="12" Foreground="{DynamicResource TextoColor}" Opacity="0.8" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PagoTotalTexto}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextoColor}" HorizontalAlignment="Right"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="PAGADO" FontSize="12" Foreground="{DynamicResource TextoColor}" Opacity="0.8" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PagoPagadoTexto}" FontSize="15" FontWeight="SemiBold" Foreground="#27AE60" HorizontalAlignment="Right"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="RESTANTE" IsVisible="{Binding !PagoEsCambio}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextoBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PagoRestanteTexto}" IsVisible="{Binding !PagoEsCambio}" FontSize="24" FontWeight="Black" Foreground="#E06A28" HorizontalAlignment="Right"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="CAMBIO" IsVisible="{Binding PagoEsCambio}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextoBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PagoRestanteTexto}" IsVisible="{Binding PagoEsCambio}" FontSize="24" FontWeight="Black" Foreground="#27AE60" HorizontalAlignment="Right"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Propina" FontSize="12" Foreground="{DynamicResource TextoColor}" Opacity="0.8" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PagoPropina, StringFormat='${0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}" HorizontalAlignment="Right"/>

                  <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding PagoError}" Foreground="#E74C3C" FontWeight="Bold" TextWrapping="Wrap"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="1" Padding="10" Background="{DynamicResource FondoModal}" CornerRadius="10">
            <Grid ColumnDefinitions="7*,3*">

              <Grid Grid.Column="0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                    <TextBlock Grid.Column="0" Text="MÉTODOS DE PAGO"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextoBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding MetodosPago}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="modals:MetodoPagoOption">
                        <Button Classes="pago-metodo"
                                Classes.activo="{Binding Seleccionado}"
                                Content="{Binding Etiqueta}"
                                Command="{Binding #Root.DataContext.SeleccionarMetodoPagoCommand}"
                                CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                    <Button Grid.Column="0" Grid.Row="0"
                            Content="Modificar propina"
                            Margin="4"
                            Classes="pago-metodo"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{Binding ModificarPropinaCommand}"/>

                    <Button Grid.Column="1" Grid.Row="0"
                            Content="Quitar propina"
                            Margin="4"
                            Classes="pago-metodo"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{Binding QuitarPropinaCommand}"/>

                    <Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                            Content="Cancelar"
                            Margin="4"
                            Classes="btn-rojo"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{Binding CancelarPagoCommand}"/>
                  </Grid>
                </StackPanel>
              </Grid>

              <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">

                <TextBlock Grid.Row="0"
                           Text="{Binding PagoTecladoAyuda}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextoColor}"
                           Opacity="0.7"
                           HorizontalAlignment="Center"/>

                <Grid Grid.Row="1" RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*" RowSpacing="5" ColumnSpacing="5">
                  <Button Grid.Row="0" Grid.Column="0" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="1" Content="1"/>
                  <Button Grid.Row="0" Grid.Column="1" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="2" Content="2"/>
                  <Button Grid.Row="0" Grid.Column="2" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="3" Content="3"/>

                  <Button Grid.Row="1" Grid.Column="0" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="4" Content="4"/>
                  <Button Grid.Row="1" Grid.Column="1" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="5" Content="5"/>
                  <Button Grid.Row="1" Grid.Column="2" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="6" Content="6"/>

                  <Button Grid.Row="2" Grid.Column="0" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="7" Content="7"/>
                  <Button Grid.Row="2" Grid.Column="1" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="8" Content="8"/>
                  <Button Grid.Row="2" Grid.Column="2" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="9" Content="9"/>

                  <Button Grid.Row="3" Grid.Column="0" Classes="KeypadBtn" Command="{Binding PuntoDecimalCommand}" Content="."/>
                  <Button Grid.Row="3" Grid.Column="1" Classes="KeypadBtn" Command="{Binding TecladoCommand}" CommandParameter="0" Content="0"/>
                  <Button Grid.Row="3" Grid.Column="2" Classes="KeypadBtn" Command="{Binding BorrarNumeroCommand}" Content="⌫"/>
                </Grid>

              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

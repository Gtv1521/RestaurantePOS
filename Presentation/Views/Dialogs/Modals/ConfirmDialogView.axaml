<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="using:MiComanderaApp.ViewModels.Dialogs.Modals"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MiComanderaApp.Views.Dialogs.Modals.ConfirmDialogView"
        Title="{Binding Title}"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource FondoModal}"
        x:DataType="vm:ConfirmDialogViewModel"
        WindowState="Maximized"
        x:Name="Root">

  <Grid RowDefinitions="*">
    <Border Grid.Row="0"
            Padding="25"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

      <StackPanel Spacing="15"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

        <Border CornerRadius="15"
                Width="600"
                Padding="25"
                Background="{DynamicResource FondoPrincipal}">

          <StackPanel Spacing="20">

            <TextBlock Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="White"/>

            <TextBlock Text="{Binding Message}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="White"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="20"
                        Margin="0,10,0,0">

              <Button Content="{Binding TextoCancelar}"
                      Width="200"
                      Height="45"
                      Classes="btn-verde"
                      Command="{Binding CancelarCommand}"/>

              <Button Content="{Binding TextoConfirmar}"
                      Width="200"
                      Height="45"
                      Classes="btn-rojo"
                      Command="{Binding ConfirmarCommand}"/>
            </StackPanel>

          </StackPanel>
        </Border>

      </StackPanel>
    </Border>
  </Grid>
</Window>

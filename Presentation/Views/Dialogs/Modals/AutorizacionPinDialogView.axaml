<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:vm="using:MiComanderaApp.ViewModels.Dialogs.Modals"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MiComanderaApp.Views.Dialogs.Modals.AutorizacionPinDialogView"
        Title="{Binding Title}"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource FondoModal}"
        x:DataType="vm:AutorizacionPinDialogViewModel"
        WindowState="Maximized"
        x:Name="Root">

  <Grid RowDefinitions="*">
    <Border Grid.Row="0"
            Padding="25"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

      <StackPanel Spacing="15"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

        <Border CornerRadius="15"
                Width="560"
                Padding="25"
                Background="{DynamicResource FondoPrincipal}">

          <StackPanel Spacing="16" HorizontalAlignment="Center">

            <TextBlock Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="White"/>

            <TextBlock Text="{Binding Message}"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="White"/>

            <TextBlock Text="{Binding RolesTexto}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Foreground="#A0AEC0"/>

            <Grid HorizontalAlignment="Center">
              <TextBox Text="{Binding PinCode}"
                       PasswordChar="●"
                       IsReadOnly="True"
                       Focusable="False"
                       FontSize="24"
                       Foreground="{DynamicResource TextoColor}"
                       LetterSpacing="14"
                       Background="Transparent"
                       BorderThickness="0"
                       TextBlock.TextAlignment="Center"
                       Width="200"/>
            </Grid>

            <Grid Width="280" Height="320"
                  HorizontalAlignment="Center"
                  ColumnDefinitions="*, *, *"
                  RowDefinitions="*, *, *, *"
                  RowSpacing="12" ColumnSpacing="12">

              <Button Grid.Row="0" Grid.Column="0" Content="1" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="1"/>
              <Button Grid.Row="0" Grid.Column="1" Content="2" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="2"/>
              <Button Grid.Row="0" Grid.Column="2" Content="3" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="3"/>

              <Button Grid.Row="1" Grid.Column="0" Content="4" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="4"/>
              <Button Grid.Row="1" Grid.Column="1" Content="5" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="5"/>
              <Button Grid.Row="1" Grid.Column="2" Content="6" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="6"/>

              <Button Grid.Row="2" Grid.Column="0" Content="7" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="7"/>
              <Button Grid.Row="2" Grid.Column="1" Content="8" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="8"/>
              <Button Grid.Row="2" Grid.Column="2" Content="9" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="9"/>

              <Button Grid.Row="3" Grid.Column="0" Classes="KeypadBtn" Command="{Binding DeleteDigitCommand}" i:Attached.Icon="fa-solid fa-delete-left" />
              <Button Grid.Row="3" Grid.Column="1" Content="0" Classes="KeypadBtn" Command="{Binding AddDigitCommand}" CommandParameter="0"/>
              <Button Grid.Row="3" Grid.Column="2" Classes="KeypadBtn" Background="{DynamicResource SaveBotton}" Foreground="{DynamicResource TextBotton}" Command="{Binding VerificarCommand}" i:Attached.Icon="fa-solid fa-arrow-right"/>
            </Grid>

            <TextBlock Text="{Binding Error}"
                       Foreground="#FF6B6B"
                       FontSize="13"
                       FontWeight="Medium"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Button Content="Cancelar"
                    Width="220"
                    Height="45"
                    HorizontalAlignment="Center"
                    Classes="btn-rojo"
                    Command="{Binding CancelarCommand}"/>

          </StackPanel>
        </Border>

      </StackPanel>
    </Border>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:b="using:MiComanderaApp.Presentation.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:vm="using:MiComanderaApp.ViewModels.Dialogs.Modals"
        xmlns:models="using:RestaurantePOS.Core.Domain.Models"
        xmlns:domainModels="using:MiComanderaApp.Core.Domain.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:in="using:Avalonia.Xaml.Interactivity"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MiComanderaApp.Views.Dialogs.Modals.RecipeEditorView"
        Title="{Binding Title}"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource FondoModal}"
        x:Name="root"
        x:DataType="vm:RecipeEditorViewModel"
        WindowState="Maximized"
        >


        <Grid RowDefinitions="*, *">
                <Border Grid.Row="0" Padding="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        >

                        <StackPanel Spacing="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch" >

                                <Border CornerRadius="15"
                                        Width="900"
                                        Padding="20"
                                        Background="{DynamicResource FondoPrincipal}"
                                        >
                                        <Grid RowDefinitions="Auto, Auto, Auto, Auto"
                                              RowSpacing="10">

                                                <TextBlock Grid.Row="0" Text="{Binding Recipe.ProductName, StringFormat='Editar Receta: {0}'}"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextoBrush}"
                                                           />

                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                                        <ItemsControl ItemsSource="{Binding RecipeIngredients}">
                                                                <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type models:IngredientModel}">
                                                                                <Border Background="{DynamicResource FondoModal}" CornerRadius="6" Padding="10" Margin="0,0,0,5">
                                                                                        <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextoColor}"/>
                                                                                                <TextBox Grid.Column="1" Text="{Binding Quantity, Mode=TwoWay}" VerticalAlignment="Center" Width="80" Margin="10,0"
                                                                                                           Background="Transparent" BorderBrush="{DynamicResource Border}" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold">
                                                                                                        <in:Interaction.Behaviors>
                                                                                                                <b:KeyboardFocusBehavior />
                                                                                                        </in:Interaction.Behaviors>
                                                                                                </TextBox>
                                                                                                <TextBlock Grid.Column="2" Text="{Binding UnitOfMeasure}" VerticalAlignment="Center" Foreground="{DynamicResource TextoColor}" Opacity="0.7" Margin="10,0"/>
                                                                                                <Button Grid.Column="3" Command="{Binding #root.DataContext.RemoveIngredientCommand}" CommandParameter="{Binding}"
                                                                                                          Background="Transparent" BorderThickness="0" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                                        <i:Icon Value="fa-solid fa-trash" Foreground="#E06A28" FontSize="14"/>
                                                                                                </Button>
                                                                                        </Grid>
                                                                                </Border>
                                                                        </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                </ScrollViewer>

                                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                                        <TextBlock Text="Añadir Ingrediente" Foreground="{DynamicResource TextoColor}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                                                                <ComboBox Grid.Column="0" ItemsSource="{Binding AllIngredients}" SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                                                                          PlaceholderText="Seleccionar ingrediente" VerticalContentAlignment="Center"
                                                                          Foreground="{DynamicResource TextoColor}" BorderBrush="{DynamicResource Border}">
                                                                        <ComboBox.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type domainModels:IngredienteModel}">
                                                                                        <TextBlock Text="{Binding Name}"/>
                                                                                </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <Grid Grid.Column="1" ColumnDefinitions="Auto, Auto" ColumnSpacing="8">
                                                                        <TextBox Text="{Binding Quantity, Mode=TwoWay}" Watermark="Cant." Width="80" VerticalContentAlignment="Center"
                                                                                 BorderBrush="{DynamicResource Border}" Foreground="{DynamicResource TextoColor}">
                                                                                <in:Interaction.Behaviors>
                                                                                        <b:KeyboardFocusBehavior />
                                                                                </in:Interaction.Behaviors>
                                                                        </TextBox>
                                                                        <TextBlock Grid.Column="1" Text="{Binding SelectedIngredient.UnitOfMeasure}" VerticalAlignment="Center" Foreground="{DynamicResource TextoColor}" Opacity="0.8" Margin="8,0,0,0"/>
                                                                </Grid>

                                                                <Button Grid.Column="2" Command="{Binding AddIngredientCommand}" Classes="btn-naranja" Padding="15, 8">
                                                                        <TextBlock Text="Añadir" FontWeight="SemiBold"/>
                                                                </Button>
                                                        </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                                                        <Button Content="Cancelar"
                                                                Width="200"
                                                                Height="40"
                                                                Classes="btn-rojo"
                                                                Command="{Binding CancelCommand}"/>
                                                        <Button Content="Guardar"
                                                                Width="200"
                                                                Height="40"
                                                                Classes="btn-verde"
                                                                Command="{Binding SaveCommand}"/>
                                                </StackPanel>

                                        </Grid>
                                </Border>

                        </StackPanel>

                </Border>

                <Grid RowDefinitions="*" Grid.Row="1" VerticalAlignment="Bottom" >

                        <Border Padding="10"
                                Margin="20"
                                Height="35"
                                Width="100"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding BotonTeclado}"
                                >
                                <StackPanel>
                                        <Button i:Attached.Icon="fa-solid fa-chevron-up" Background="{DynamicResource FondoPrincipal}"  Classes="KeypadBtn" Command="{Binding VerTecladoCommand}" />
                                </StackPanel>
                        </Border>

                        <ContentControl Padding="10" Height="500" IsVisible="{Binding Teclado}" Grid.Row="1" Content="{Binding VistaActual}" />
                </Grid>
        </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MiComanderaApp.ViewModels.Dialogs.Modals"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="550"
        x:Class="MiComanderaApp.Views.Dialogs.Modals.EditIngrediente"
        x:DataType="vm:EditIngredienteDialogViewModel"
        Title="{Binding Title}"
        CanResize="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent">

  <Border CornerRadius="10" Background="#2c3e50" Padding="20" BoxShadow="0 0 20 5 #1c2833">
    <StackPanel Spacing="15" Width="350">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>

      <TextBlock Text="Nombre del Ingrediente" Foreground="White"/>
      <TextBox Text="{Binding Name}" />

      <TextBlock Text="Cantidad Mínima en Inventario" Foreground="White"/>
      <NumericUpDown Value="{Binding MinimumQuantity}" FormatString="N2" />

      <TextBlock Text="Costo por Unidad" Foreground="White"/>
      <NumericUpDown Value="{Binding UnitCost}" FormatString="C2" />

      <TextBlock Text="Unidad de Medida (ej: Kg, Lt, Un)" Foreground="White"/>
      <TextBox Text="{Binding UnitOfMeasure}" />

      <Grid ColumnDefinitions="*,*" Margin="0 10 0 0">
        <TextBlock Grid.Column="0" Text="Cantidad Actual:" FontWeight="Bold" Foreground="#bdc3c7" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding CurrentQuantity, StringFormat={}{0:N2}}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>

      <Border BorderBrush="#34495e" BorderThickness="1" Padding="10" CornerRadius="5">
        <StackPanel Spacing="10">
          <TextBlock Text="Ajustar Inventario" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>

          <TextBlock Text="Añadir Cantidad:" Foreground="#2ecc71"/>
          <NumericUpDown Value="{Binding QuantityToAdd}" FormatString="N2" />

          <TextBlock Text="Retirar Cantidad (por merma, etc.):" Foreground="#e74c3c"/>
          <NumericUpDown Value="{Binding QuantityToRemove}" FormatString="N2" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" Margin="0 20 0 0">
        <Button Grid.Column="0" Content="Guardar Cambios" Command="{Binding GuardarCommand}" Classes="primary" Margin="0,0,5,0"/>
        <Button Grid.Column="1" Content="Cancelar" Command="{Binding CancelarCommand}" Classes="secondary" Margin="5,0,0,0"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
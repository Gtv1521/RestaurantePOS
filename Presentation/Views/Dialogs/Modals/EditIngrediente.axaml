<Window xmlns="https://github.com/avaloniaui"
        xmlns:b="using:MiComanderaApp.Presentation.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:vm="using:MiComanderaApp.ViewModels.Dialogs.Modals"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:in="using:Avalonia.Xaml.Interactivity"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MiComanderaApp.Views.Dialogs.Modals.EditIngrediente"
        Title="{Binding Title}"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource FondoModal}"
        x:DataType="vm:EditIngredienteDialogViewModel"
        WindowState="Maximized"
        x:Name="Root"
        >


        <Grid RowDefinitions="*, *">
                <Border Grid.Row="0" Padding="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        >

                        <StackPanel Spacing="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch" >

                                <Border CornerRadius="15"
                                        Width="900"
                                        Padding="20"
                                        Background="{DynamicResource FondoPrincipal}"
                                        >
                                        <Grid ColumnDefinitions="*, *"
                                              RowDefinitions="*,*,*"
                                              RowSpacing="10"
                                              ColumnSpacing="10"
                                              >

                                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextoBrush}"
                                                           />

                                                <StackPanel Spacing="15" Grid.Row="1" Grid.Column="0">

                                                        <TextBlock Text="Nombre del Ingrediente" Foreground="{DynamicResource TextoColor}"/>

                                                        <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                                 x:Name="TxtNombre"
                                                                 Watermark="Ej: Tomate" BorderBrush="{DynamicResource Border}"
                                                                 Foreground="{DynamicResource TextoColor}">
                                                                <in:Interaction.Behaviors>
                                                                        <b:KeyboardFocusBehavior />
                                                                </in:Interaction.Behaviors>
                                                        </TextBox>

                                                        <TextBlock Text="Cantidad Mínima en Inventario"
                                                                   Foreground="{DynamicResource TextoColor}"/>

                                                        <TextBox Text="{Binding MinimumQuantity, Mode=TwoWay}"
                                                                 x:Name="TxtCantidadMinima"
                                                                 BorderBrush="{DynamicResource Border}"
                                                                 Watermark="0.00" Foreground="{DynamicResource TextoColor}">
                                                                <in:Interaction.Behaviors>
                                                                        <b:KeyboardFocusBehavior />
                                                                </in:Interaction.Behaviors>
                                                        </TextBox>

                                                        <TextBlock Text="Costo por Unidad"
                                                                   Foreground="{DynamicResource TextoColor}"/>

                                                        <TextBox Text="{Binding UnitCost, Mode=TwoWay}"
                                                                 x:Name="TxtCosto"
                                                                 BorderBrush="{DynamicResource Border}"
                                                                 Watermark="0.00" Foreground="{DynamicResource TextoColor}">
                                                                <in:Interaction.Behaviors>
                                                                        <b:KeyboardFocusBehavior />
                                                                </in:Interaction.Behaviors>
                                                        </TextBox>

                                                        <TextBlock Text="Unidad de Medida" Foreground="{DynamicResource TextoColor}"/>

                                                        <TextBox Text="{Binding UnitOfMeasure, Mode=TwoWay}"
                                                                 x:Name="TxtUnidad"
                                                                 Foreground="{DynamicResource TextoColor}"
                                                                 BorderBrush="{DynamicResource Border}"
                                                                 Watermark="Ej: Kg, L, Unidad">
                                                                <in:Interaction.Behaviors>
                                                                        <b:KeyboardFocusBehavior />
                                                                </in:Interaction.Behaviors>
                                                        </TextBox>

                                                </StackPanel>

                                                <StackPanel Spacing="15" Grid.Row="1" Grid.Column="1">

                                                        <Grid ColumnDefinitions="*,*">
                                                                <TextBlock Grid.Column="0" Text="Cantidad Actual:" FontWeight="Bold" Foreground="{DynamicResource TextoColor}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding CurrentQuantity, StringFormat={}{0:N2}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextoBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>

                                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10" CornerRadius="5">
                                                                <StackPanel Spacing="10">
                                                                        <TextBlock Text="Ajustar Inventario" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextoBrush}"/>

                                                                        <TextBlock Text="Añadir Cantidad:" Foreground="{DynamicResource TextoColor}"/>

                                                                        <TextBox Text="{Binding QuantityToAdd, Mode=TwoWay}"
                                                                                 x:Name="TxtCantidadAñadir"
                                                                                 BorderBrush="{DynamicResource Border}"
                                                                                 Watermark="0.00" Foreground="{DynamicResource TextoColor}">
                                                                                <in:Interaction.Behaviors>
                                                                                        <b:KeyboardFocusBehavior />
                                                                                </in:Interaction.Behaviors>
                                                                        </TextBox>

                                                                        <TextBlock Text="Retirar Cantidad (por merma, etc.):" Foreground="{DynamicResource TextoColor}"/>

                                                                        <TextBox Text="{Binding QuantityToRemove, Mode=TwoWay}"
                                                                                 x:Name="TxtCantidadRetirar"
                                                                                 BorderBrush="{DynamicResource Border}"
                                                                                 Watermark="0.00" Foreground="{DynamicResource TextoColor}">
                                                                                <in:Interaction.Behaviors>
                                                                                        <b:KeyboardFocusBehavior />
                                                                                </in:Interaction.Behaviors>
                                                                        </TextBox>
                                                                </StackPanel>
                                                        </Border>

                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Spacing="10"
                                                            Margin="0,20,0,0">

                                                        <Button Content="Cancelar"
                                                                Width="200"
                                                                Height="40"
                                                                Classes="btn-rojo"
                                                                Command="{Binding CancelarCommand}"/>

                                                        <Button Content="Guardar"
                                                                Width="200"
                                                                Height="40"
                                                                Classes="btn-verde"
                                                                Command="{Binding GuardarCommand}"/>

                                                </StackPanel>

                                        </Grid>
                                </Border>

                        </StackPanel>

                </Border>

                <Grid RowDefinitions="*" Grid.Row="1" VerticalAlignment="Bottom" >

                        <Border Padding="10"
                                Margin="20"
                                Height="35"
                                Width="100"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding BotonTeclado}"
                                >
                                <StackPanel>
                                        <Button i:Attached.Icon="fa-solid fa-chevron-up" Background="{DynamicResource FondoPrincipal}"  Classes="KeypadBtn" Command="{Binding VerTecladoCommand}" />
                                </StackPanel>
                        </Border>

                        <ContentControl Padding="10" Height="500" IsVisible="{Binding Teclado}" Grid.Row="1" Content="{Binding VistaActual}" />
                </Grid>
        </Grid>
</Window>

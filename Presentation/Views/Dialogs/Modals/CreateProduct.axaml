<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:MiComanderaApp.Presentation.Views.Dialogs.Modals"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MiComanderaApp.Presentation.Views.Dialogs.Modals.CreateProduct"
        Title="CreateProduct"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource FondoModal}"
        x:DataType="local:CreateProductViewModel"
        WindowState="Maximized">

        <Border Padding="25"
                CornerRadius="15"
                Background="{DynamicResource FondoPrincipal}"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                MaxHeight="450"
                Width="900">


                <Border Padding="25"
                        CornerRadius="15">

                        <StackPanel Spacing="15">

                                <Grid ColumnDefinitions="*, *" RowDefinitions="*,*,*"  ColumnSpacing="10" RowSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Crear Producto"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextoBrush}"
                                                   />

                                        <StackPanel Spacing="15" Grid.Row="1" Grid.Column="0">

                                                <TextBlock Text="Nombre" Foreground="{DynamicResource TextoColor}"/>

                                                <TextBox Text="{Binding Nombre}"
                                                         Watermark="Ej: Hamburguesa clásica" BorderBrush="{DynamicResource Border}"/>


                                                <TextBlock Text="Código"
                                                           Foreground="{DynamicResource TextoColor}"/>

                                                <TextBox Text="{Binding Codigo}"
                                                         BorderBrush="{DynamicResource Border}"
                                                         Watermark="Código interno" Foreground="{DynamicResource TextoColor}"/>


                                                <TextBlock Text="Precio"
                                                           Foreground="{DynamicResource TextoColor}"
                                                           />

                                                <TextBox Text="{Binding Precio}"
                                                         Foreground="{DynamicResource TextoColor}"
                                                         BorderBrush="{DynamicResource Border}"
                                                         Watermark="0.00"/>
                                        </StackPanel>

                                        <StackPanel Spacing="15" Grid.Row="1" Grid.Column="1">

                                                <TextBlock Text="Categoría"
                                                           Foreground="{DynamicResource TextoColor}"/>

                                                <ComboBox ItemsSource="{Binding Categorias}"
                                                          SelectedItem="{Binding CategoriaSeleccionada}"
                                                          Foreground="{DynamicResource TextoColor}"
                                                          BorderBrush="{DynamicResource Border}">

                                                        <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                        <TextBlock Text="{Binding Name}" />
                                                                </DataTemplate>
                                                        </ComboBox.ItemTemplate>

                                                </ComboBox>

                                                <TextBlock Text="Descripción" Foreground="{DynamicResource TextoColor}"/>

                                                <TextBox Text="{Binding Descripcion}"
                                                         Height="80"
                                                         Foreground="{DynamicResource TextoColor}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"/>


                                                <CheckBox Content="Producto activo"
                                                          IsChecked="{Binding Activo}"/>

                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="10"
                                                    Margin="0,20,0,0">

                                                <Button Content="Cancelar"
                                                        Width="200"
                                                        Height="40"
                                                        Classes="btn-rojo"
                                                        Command="{Binding CancelarCommand}"/>

                                                <Button Content="Guardar"
                                                        Width="200"
                                                        Height="40"
                                                        Classes="btn-verde"
                                                        Background="#4CAF50"
                                                        Command="{Binding GuardarCommand}"/>

                                        </StackPanel>

                                </Grid>

                        </StackPanel>

                </Border>

        </Border>
</Window>

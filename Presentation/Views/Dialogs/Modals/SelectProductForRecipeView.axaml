<Window xmlns="https://github.com/avaloniaui"
        xmlns:b="using:MiComanderaApp.Presentation.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:vm="using:MiComanderaApp.ViewModels.Dialogs.Modals"
        xmlns:models="using:MiComanderaApp.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:in="using:Avalonia.Xaml.Interactivity"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MiComanderaApp.Views.Dialogs.Modals.SelectProductForRecipeView"
        Title="{Binding Title}"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource FondoModal}"
        x:DataType="vm:SelectProductForRecipeViewModel"
        WindowState="Maximized"
        x:Name="Root"
        >


        <Grid RowDefinitions="*, *">
                <Border Grid.Row="0" Padding="25"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        >

                        <StackPanel Spacing="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch" >

                                <Border CornerRadius="15"
                                        Width="900"
                                        Padding="20"
                                        Background="{DynamicResource FondoPrincipal}"
                                        >
                                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                                              RowSpacing="10">

                                                <TextBlock Grid.Row="0" Text="{Binding Title}"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextoBrush}"
                                                           />

                                                <TextBlock Grid.Row="1" Text="Elige el producto al que quieres asignar la receta:" Foreground="{DynamicResource TextoColor}" Opacity="0.8"/>

                                                <TextBox Grid.Row="2" Text="{Binding SearchText, Mode=TwoWay}" Watermark="Buscar producto..."
                                                         Background="{DynamicResource FondoModal}" Foreground="{DynamicResource TextoColor}" BorderBrush="{DynamicResource Border}">
                                                        <in:Interaction.Behaviors>
                                                                <b:KeyboardFocusBehavior />
                                                        </in:Interaction.Behaviors>
                                                </TextBox>

                                                <ListBox Grid.Row="3" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" MaxHeight="300">
                                                        <ListBox.ItemTemplate>
                                                                <DataTemplate DataType="models:ProductoModel">
                                                                        <Border Padding="10" Margin="0,0,0,6" Background="{DynamicResource FondoInput}" CornerRadius="6">
                                                                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                                                        <StackPanel>
                                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextoColor}"/>
                                                                                                <TextBlock Text="{Binding CategoryName}" FontSize="12" Opacity="0.7" Foreground="{DynamicResource TextoColor}"/>
                                                                                        </StackPanel>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:C}'}" VerticalAlignment="Center" Foreground="{DynamicResource TextoColor}" Opacity="0.9"/>
                                                                                </Grid>
                                                                        </Border>
                                                                </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                </ListBox>

                                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                                                        <Button Content="Cancelar"
                                                                Width="200"
                                                                Height="40"
                                                                Classes="btn-rojo"
                                                                Command="{Binding CancelCommand}"/>
                                                        <Button Content="Seleccionar"
                                                                Width="200"
                                                                Height="40"
                                                                Classes="btn-verde"
                                                                Command="{Binding SelectCommand}"/>
                                                </StackPanel>

                                        </Grid>
                                </Border>

                        </StackPanel>

                </Border>

                <Grid RowDefinitions="*" Grid.Row="1" VerticalAlignment="Bottom" >

                        <Border Padding="10"
                                Margin="20"
                                Height="35"
                                Width="100"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding BotonTeclado}"
                                >
                                <StackPanel>
                                        <Button i:Attached.Icon="fa-solid fa-chevron-up" Background="{DynamicResource FondoPrincipal}"  Classes="KeypadBtn" Command="{Binding VerTecladoCommand}" />
                                </StackPanel>
                        </Border>

                        <ContentControl Padding="10" Height="500" IsVisible="{Binding Teclado}" Grid.Row="1" Content="{Binding VistaActual}" />
                </Grid>
        </Grid>
</Window>
